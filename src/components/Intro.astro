---
// Q7's survey, laid over the home page on every visit (a #chapter link skips it). It ends on the
// home page's own first frame and hands the cloud over, so the orchard never cuts.
import { site } from '../lib/site';
---

<script is:inline>
  // Decide before the first paint, so the home page never flashes underneath
  (function () {
    if (!location.hash) {
      document.documentElement.dataset.intro = 'on';
      document.documentElement.classList.add('intro-ran');
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    }
  })();
</script>

<section class="intro" data-survey data-phase="welcome" aria-label="Introduction and optional robot survey">
  <canvas class="intro__canvas" data-intro-canvas aria-hidden="true"></canvas>

  <div class="intro__welcome" data-welcome>
    <p class="intro__bio">I'm <span>{site.name}</span>, a Computer Vision &amp; Machine Learning Engineer transforming AI models into production-ready solutions.</p>
  </div>

  <div class="intro__arrival" role="status">
    <span>Q7 is rolling in</span>
    <span class="intro__trail" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="m11 5-5 5 5 5M6 10h10" />
      </svg>
      <span></span><span></span><span></span>
    </span>
  </div>

  <div class="intro__sub">
    <p class="intro__line" aria-live="polite">
      <span class="intro__who" data-who>Q7</span>
      <span class="intro__text" data-line></span>
    </p>
    <div class="intro__opts" data-opts role="group" aria-label="Your answer"></div>
  </div>

  <button class="intro__corner intro__sound" type="button" data-sound aria-pressed="true" aria-label="Sound">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" />
      <path class="intro__waves" d="M15.5 9.5a3.5 3.5 0 0 1 0 5M18 7a7 7 0 0 1 0 10" />
      <path class="intro__slash" d="M3.5 3.5l17 17" />
    </svg>
  </button>
  <button class="intro__corner intro__skip" type="button" data-skip>Skip to the portfolio</button>
</section>

<script>
  import { initIntro } from '../scripts/intro';
  const root = document.querySelector<HTMLElement>("[data-survey]");
  if (root && document.documentElement.dataset.intro === 'on') {
    scrollTo(0, 0);
    // the page underneath is out of reach until the survey is over
    root.parentElement?.querySelectorAll(':scope > :not([data-survey])').forEach((el) => {
      el.setAttribute('inert', '');
      el.setAttribute('data-intro-inert', '');
    });
    root.classList.add('is-on');
    initIntro(root);
  } else root?.remove();
</script>

<style>
  .intro {
    display: none;
  }

  :global(html[data-intro='on']) {
    overflow: hidden;
  }

  /* the camera view toggle belongs to the home cloud, not to the survey */
  :global(html[data-intro='on'] .top__view) {
    visibility: hidden;
  }

  /* the home copy waits behind the survey and arrives once the orchard is the home page's */
  :global(html[data-intro='on'] .hello) {
    opacity: 0;
    translate: 0 1.2rem;
  }

  :global(html.intro-ran .hello) {
    transition: opacity 1.2s 0.25s, translate 1.2s 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* visible until the home loop has drawn its first frame, then removed in the same frame */
  .intro.is-on {
    position: fixed;
    inset: 0;
    z-index: 35;
    background: #000;
    min-height: 100dvh;
    display: grid;
    align-items: end;
    justify-items: center;
    padding: 5rem var(--pad) clamp(4.2rem, 8vh, 6rem);
    overflow: hidden;
  }

  .intro__canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  :global(.no-gl) .intro__canvas {
    display: none;
  }

  .intro__welcome {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 6rem var(--pad);
    pointer-events: none;
    will-change: transform, opacity;
  }

  .intro__bio {
    width: min(100%, 24ch);
    font-size: clamp(2rem, 1rem + 3.6vw, 4.8rem);
    font-stretch: 75%;
    font-weight: 650;
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
    animation: bio-in 0.65s ease-out both;
  }

  .intro__bio span {
    color: var(--hot);
  }

  .intro__welcome[hidden] {
    display: none;
  }

  @keyframes bio-in {
    from { opacity: 0; translate: 0 0.6rem; }
    to { opacity: 1; translate: 0 0; }
  }

  .intro[data-phase='welcome'] .intro__sub,
  .intro[data-phase='enter'] .intro__sub {
    visibility: hidden;
  }

  .intro__arrival {
    position: absolute;
    right: var(--pad);
    bottom: clamp(6rem, 13svh, 9rem);
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--hot);
    font-size: 0.8125rem;
    font-weight: 500;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s, visibility 0.35s;
  }

  .intro[data-phase='welcome'] .intro__arrival,
  .intro[data-phase='enter'] .intro__arrival {
    opacity: 1;
    visibility: visible;
  }

  .intro__trail {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .intro__trail > span {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    animation: approaching 1.4s ease-in-out infinite;
  }

  .intro__trail > span:nth-of-type(1) { animation-delay: 0.4s; }
  .intro__trail > span:nth-of-type(2) { animation-delay: 0.2s; }

  @keyframes approaching {
    0%, 100% { opacity: 0.2; transform: translateX(3px); }
    50% { opacity: 1; transform: translateX(-3px); }
  }

  /* subtitles: film style, centred, on a scrim so they read over any point */
  .intro__sub {
    position: relative;
    width: min(100%, 44rem);
    text-align: center;
  }

  .intro__line {
    min-height: 3.1em;
    font-size: clamp(1.2rem, 0.9rem + 1.1vw, 1.85rem);
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }

  .intro__who {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--hot);
    font-variant-numeric: tabular-nums;
  }

  /* the speaker label waits for the first word, so the opening frame is never a lone label */
  .intro__line:has(.intro__text:empty) .intro__who {
    opacity: 0;
  }

  .intro__text {
    padding: 0.08em 0.35em;
    background: rgb(0 0 0 / 0.72);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .intro__text:empty {
    padding: 0;
  }

  .intro__opts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    min-height: 2.9rem;
    margin-top: 1.4rem;
  }

  .intro__opts :global(.intro__opt) {
    --i: 0;
    padding: 0.7rem 1.15rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background-color: #000;
    background-image: linear-gradient(var(--fg) 0 0);
    background-repeat: no-repeat;
    background-size: 0% 100%;
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-size 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.3s, opacity 0.4s, border-color 0.3s;
    animation: opt-in 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--i) * 60ms + 80ms);
  }

  @keyframes opt-in {
    from {
      opacity: 0;
      translate: 0 0.6rem;
    }
  }

  @media (hover: hover) {
    .intro__opts :global(.intro__opt):not(:disabled):hover {
      background-size: 100% 100%;
      color: #000;
    }
  }

  .intro__opts :global(.intro__opt):focus-visible {
    outline: 2px solid var(--hot);
    outline-offset: 3px;
  }

  .intro__opts :global(.intro__opt):active:not(:disabled) {
    scale: 0.97;
  }

  .intro__opts :global(.intro__opt):disabled {
    cursor: default;
    opacity: 0.32;
  }

  .intro__opts :global(.intro__opt.is-picked) {
    opacity: 1;
    background-size: 100% 100%;
    background-image: linear-gradient(var(--hot) 0 0);
    border-color: var(--hot);
    color: #000;
  }

  .intro.is-gone {
    opacity: 0;
    transition: opacity 0.7s;
  }

  .intro[data-phase='leave'] .intro__sub,
  .intro[data-phase='leave'] .intro__corner {
    opacity: 0;
    translate: 0 1rem;
    transition: opacity 0.8s, translate 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .intro__corner {
    position: fixed;
    bottom: 1rem;
    padding: 0.35rem 0;
    border: 0;
    background: linear-gradient(currentColor 0 0) left 100% / 0% 2px no-repeat;
    color: var(--muted);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-size 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.3s;
  }

  .intro__sound {
    left: calc(var(--pad) - 0.6rem);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: none;
    border-radius: 50%;
    transition: color 0.3s, scale 0.2s;
  }

  .intro__sound svg path {
    transition: opacity 0.25s;
  }

  .intro__sound[aria-pressed='true'] .intro__slash,
  .intro__sound[aria-pressed='false'] .intro__waves {
    opacity: 0;
  }

  .intro__sound:active {
    scale: 0.92;
  }

  .intro__sound:focus-visible {
    outline: 2px solid var(--hot);
    outline-offset: 2px;
  }

  .intro__skip {
    right: var(--pad);
    padding: 0.6rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--fg);
    background: var(--bg);
  }

  @media (hover: hover) {
    .intro__corner:hover {
      background-size: 100% 2px;
      color: var(--fg);
    }
  }

  .intro__corner:focus-visible {
    background-size: 100% 2px;
    color: var(--fg);
  }

  @media (max-width: 480px) {
    .intro {
      padding-bottom: 3.6rem;
    }
    .intro__opts :global(.intro__opt) {
      padding: 0.65rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__trail > span {
      animation: none;
    }
    .intro__arrival {
      transition: none;
    }
    .intro__bio {
      animation: none;
    }
    .intro__opts :global(.intro__opt) {
      animation: none;
    }
    .intro.is-gone,
    .intro[data-phase='leave'] .intro__sub,
    .intro[data-phase='leave'] .intro__corner {
      transition: none;
    }
  }
</style>
