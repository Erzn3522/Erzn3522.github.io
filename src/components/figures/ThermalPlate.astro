---
// Schematic: a plate seen from the thermal camera, with four subsurface cracks.
// Deeper cracks look softer and fainter at the surface. Same layout as the
// interactive thermal figure (src/lib/thermal.ts).
import { CRACKS, PLATE, depthText } from '../../lib/thermal';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const k = 560 / PLATE.w; // plate fills 560 x 420 → scaled into the 640 x 400 box below
const s = 360 / PLATE.h;
const sc = Math.min(k, s);
const w = PLATE.w * sc;
const h = PLATE.h * sc;
const x0 = (640 - w) / 2;
const y0 = (400 - h) / 2;
const X = (mm: number) => x0 + mm * sc;
const Y = (mm: number) => y0 + mm * sc;
---

<svg class="diagram" viewBox="0 0 640 400" role="img" aria-label="Schematic of a plate seen from the thermal camera, with four hidden cracks at 0.4, 0.8, 1.2 and 1.8 mm depth. Deeper cracks appear softer and fainter at the surface.">
  <defs>
    <linearGradient id={`iron-${compact ? 'c' : 'f'}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2a0c45" />
      <stop offset="0.6" stop-color="#5c1468" />
      <stop offset="1" stop-color="#8a1f5e" />
    </linearGradient>
    <filter id={`glow-${compact ? 'c' : 'f'}`} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="5" />
    </filter>
  </defs>
  <rect class="d-ground" width="640" height="400" />
  <rect x={x0} y={y0} width={w} height={h} fill={`url(#iron-${compact ? 'c' : 'f'})`} class="d-ink" stroke-width="2" />
  {CRACKS.map((c) => (
    <g>
      <path
        d={`M${X(c.x1)} ${Y(c.y1)}L${X(c.x2)} ${Y(c.y2)}`}
        stroke="#ffb347"
        filter={`url(#glow-${compact ? 'c' : 'f'})`}
        stroke-width={8 + c.depth * 10}
        stroke-opacity={0.95 - c.depth * 0.38}
        stroke-linecap="round"
      />
      <path
        d={`M${X(c.x1)} ${Y(c.y1)}L${X(c.x2)} ${Y(c.y2)}`}
        stroke="#fff3c4"
        stroke-width={2.5}
        stroke-opacity={0.85 - c.depth * 0.35}
        stroke-linecap="round"
      />
      {!compact && (
        <text x={X(Math.min(c.x1, c.x2)) - 6} y={Y(Math.min(c.y1, c.y2)) - 14} class="d-leaf-text">
          {depthText(c.depth)}
        </text>
      )}
    </g>
  ))}
</svg>
