---
import { site } from '../lib/site';

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'Experience', href: '/#experience' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="site-header wrap">
  <a class="name" href="/">
    <span class="name__full">{site.name}</span>
    <span class="name__role">Computer vision engineer, {site.location}</span>
  </a>
  <nav aria-label="Main">
    <ul role="list">
      {nav.map((item) => (
        <li><a class="draw" href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  .name {
    display: grid;
    gap: 0.1rem;
    line-height: 1.1;
  }

  .name__full {
    font-size: var(--t-m);
    font-stretch: 118%;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .name__role {
    font-size: var(--t-s);
    font-stretch: 75%;
    font-weight: 500;
    color: var(--c-muted);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem clamp(1rem, 2vw, 2rem);
    list-style: none;
    padding-top: 0.2rem;
  }

  /* Nav: the underline draws in the depth colour; focus keeps it */
  .draw {
    display: inline-block;
    padding-block: 0.4rem;
    font-size: var(--t-body);
    font-stretch: 100%;
    font-weight: 550;
    background: linear-gradient(var(--c-depth) 0 0) left calc(100% - 0.2rem) / 0% 2px no-repeat;
    transition: background-size 0.45s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .name__full {
    justify-self: start;
    background: linear-gradient(var(--c-depth) 0 0) left 100% / 0% 2px no-repeat;
    transition: background-size 0.45s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  @media (hover: hover) {
    .draw:hover,
    .name:hover .name__full {
      background-size: 100% 2px;
    }
  }

  .name:focus-visible .name__full {
    background-size: 100% 2px;
  }

  .draw:focus-visible {
    background-size: 100% 2px;
  }

  @media (max-width: 640px) {
    nav {
      width: 100%;
    }
    nav ul {
      justify-content: space-between;
    }
  }
</style>
