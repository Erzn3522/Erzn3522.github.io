---
import { site, mailto } from '../lib/site';

const nav = [
  { label: 'Work', href: '/#replay' },
  { label: 'Self-study', href: '/projects/ml-first-principles' },
];
---

<header class="site-header wrap">
  <a class="name" href="/">
    <span class="name__full">{site.name}</span>
    <span class="name__role">Computer vision engineer in {site.location}</span>
  </a>
  <nav aria-label="Main">
    <ul role="list">
      {nav.map((item) => (
        <li>
          <a class="roll" href={item.href}><span>{item.label}</span><span aria-hidden="true">{item.label}</span></a>
        </li>
      ))}
      <li>
        <a class="roll" href={site.cv} download="Abdullah-Erzin-CV.pdf"><span>CV</span><span aria-hidden="true">CV</span></a>
      </li>
      <li>
        <a class="roll roll--accent" href={mailto}><span>Email</span><span aria-hidden="true">Email</span></a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }

  .name {
    display: grid;
    gap: 0.1rem;
    line-height: 1.1;
  }

  .name__full {
    justify-self: start;
    font-size: var(--t-m);
    font-stretch: 112%;
    font-weight: 750;
    letter-spacing: -0.02em;
    background: linear-gradient(var(--c-accent) 0 0) left 100% / 0% 2px no-repeat;
    transition: background-size 0.45s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .name__role {
    font-size: var(--t-s);
    color: var(--c-muted);
  }

  @media (hover: hover) {
    .name:hover .name__full {
      background-size: 100% 2px;
    }
  }

  .name:focus-visible .name__full {
    background-size: 100% 2px;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem clamp(1rem, 2.2vw, 2.2rem);
    list-style: none;
    padding-top: 0.2rem;
  }

  /* Nav: the label steps up one line, a frame advance, and lands identical to rest */
  .roll {
    display: inline-grid;
    overflow: clip;
    padding-block: 0.35rem;
    font-weight: 600;
  }

  .roll > span {
    grid-area: 1 / 1;
    transition: translate 0.45s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .roll > span + span {
    translate: 0 110%;
    color: #b23c0c;
  }

  .roll--accent > span {
    padding-bottom: 2px;
    background: linear-gradient(var(--c-accent) 0 0) left 100% / 100% 2px no-repeat;
  }

  @media (hover: hover) {
    .roll:hover > span {
      translate: 0 -110%;
    }
    .roll:hover > span + span {
      translate: 0 0;
    }
  }

  .roll:focus-visible > span {
    translate: 0 -110%;
  }

  .roll:focus-visible > span + span {
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .roll > span {
      transition: none;
      translate: none !important;
    }
    .roll > span + span {
      visibility: hidden;
    }
    .roll:focus-visible,
    .roll:hover {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  @media (max-width: 640px) {
    nav {
      width: 100%;
    }
    nav ul {
      justify-content: space-between;
    }
  }
</style>
