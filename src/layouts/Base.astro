---
import '../styles/global.css';
import { site, mailto } from '../lib/site';
import fontLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The view toggle only makes sense where a point cloud is on screen */
  cloud?: boolean;
}

const { title, description = site.description, noindex = false, cloud = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, computer vision engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Logatec', addressCountry: 'SI' },
  sameAs: site.links.map((l) => l.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="top__name" href="/">{site.name}</a>
      <nav aria-label="Main" class="top__nav">
        {cloud && (
          <button class="top__view" type="button" data-view-toggle aria-pressed="false">
            <span class="top__swatch" aria-hidden="true"></span>Camera view
          </button>
        )}
        <a class="top__link" href={site.cv} download="Abdullah-Erzin-CV.pdf">CV</a>
        <a class="top__link" href={mailto}>Email</a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem var(--pad);
    color: var(--fg);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.95);
    pointer-events: none;
  }

  .top > * {
    pointer-events: auto;
  }

  .top__name {
    font-weight: 700;
    font-stretch: 75%;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .top__name,
  .top__view {
    transition: background-size 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s, color 0.3s;
  }

  .top__name {
    background: linear-gradient(currentColor 0 0) left 100% / 0% 2px no-repeat;
  }

  @media (hover: hover) {
    .top__name:hover {
      background-size: 100% 2px;
    }
    .top__view:hover {
      background-color: #fff;
      color: #000;
    }
  }

  .top__name:focus-visible {
    background-size: 100% 2px;
  }

  .top__nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.8rem);
  }

  .top__link {
    display: inline-block;
    min-width: 24px;
    padding-block: 0.35rem;
    text-align: center;
    font-weight: 600;
    text-decoration: none;
    background: linear-gradient(currentColor 0 0) left 100% / 0% 2px no-repeat;
    transition: background-size 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (hover: hover) {
    .top__link:hover {
      background-size: 100% 2px;
    }
  }

  .top__link:focus-visible {
    background-size: 100% 2px;
  }

  .top__view {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .top__swatch {
    width: 1.4rem;
    height: 0.55rem;
    border-radius: 99px;
    background: linear-gradient(90deg, #30123b, #4686fb, #1ae4b6, #a2fc3c, #fabb39, #e4460a, #7a0403);
    transition: filter 0.3s;
  }

  .top__view[aria-pressed='true'] .top__swatch {
    filter: grayscale(1);
  }

  @media (max-width: 480px) {
    .top__nav {
      gap: 0.9rem;
    }
    .top__view {
      font-size: 0;
      gap: 0;
      padding: 0.6rem 0.55rem;
    }
    .top__link {
      font-size: 0.95rem;
    }
  }
</style>
