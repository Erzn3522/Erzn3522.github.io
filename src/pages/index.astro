---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import Diagram from '../components/Diagram.astro';
import { mailto } from '../lib/site';
import { experience, skills } from '../data/experience';
import { stops, live } from '../data/replay';
import { range } from '../lib/format';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <!-- ───────── Live: the head of the recording ───────── -->
  <section id="top" class="hero wrap" aria-labelledby="hero-title">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title" data-split="lines" data-intro data-lcp>
        I make robots see well enough to pick fruit in&nbsp;sunlight.
      </h1>
      <p class="hero__sub" data-reveal="up" data-intro data-delay="0.2" data-lcp>
        Computer vision engineer at Pek Automotive in Slovenia: calibration, stereo depth and detection, from
        the algorithm to the field. Robotics and machine vision since 2020, replayed below.
      </p>
      <p class="hero__actions" data-reveal="up" data-intro data-delay="0.3">
        <a class="play play--solid" href="#replay" data-play-replay>Watch the replay <span class="play__arrow" aria-hidden="true">▶</span></a>
        <a class="play" href={mailto}>Email me <span class="play__arrow" aria-hidden="true">→</span></a>
      </p>
      <div class="hero__panels" data-reveal="fade" data-intro data-delay="0.45">
        <div class="panel metric">
          <p class="panel__bar"><span>METRIC</span><span>{live.period}</span></p>
          <p class="metric__value">{live.metric.value}</p>
          <p class="metric__context">{live.metric.context}</p>
        </div>
        <div class="panel log">
          <p class="panel__bar"><span>LOG</span><span>{live.org}</span></p>
          <ul role="list">
            {live.log.map((l) => <li class="mono">{l}</li>)}
          </ul>
        </div>
      </div>
    </div>
    <div class="hero__camera panel" data-reveal="clip" data-intro data-delay="0.1">
      <p class="panel__bar">
        <span>CAMERA</span><span><span class="rec" aria-hidden="true"></span>LIVE</span>
      </p>
      <div class="hero__scene"><HeroScene /></div>
      <p class="hero__open">
        <a class="link" href={live.href} data-title>{live.title}</a>
      </p>
    </div>
  </section>

  <!-- ───────── Replay: scrolling rewinds to 2020 ───────── -->
  <section id="replay" class="replay wrap" aria-labelledby="replay-title" data-replay>
    <div class="replay__head">
      <h2 id="replay-title" class="section-title" data-split="lines">Replay</h2>
      <p class="replay__hint">
        Scroll to rewind from today to 2020, or pick a track on the timeline at the bottom of the screen. Each
        stop shows what that system saw, with one real number.
        <span class="replay__playing mono" aria-hidden="true">Playing. Scroll or press any key to take over.</span>
      </p>
    </div>
    <div class="replay__grid">
      <div class="viewer" data-viewer aria-hidden="true">
        <div class="panel viewer__camera">
          <p class="panel__bar">
            <span>CAMERA</span>
            {stops.map((s, i) => <span data-for={s.id} hidden={i > 0}>{s.period}</span>)}
          </p>
          <div class="viewer__frame">
            {stops.map((s, i) => (
              <div class="viewer__fig" data-for={s.id} hidden={i > 0}>
                {s.panel.kind === 'figure' ? (
                  <Diagram name={s.panel.diagram as any} />
                ) : (
                  <div class="viewer__type">
                    <span class="mono">NO FIGURE</span>
                  </div>
                )}
                <p class="viewer__caption mono">{s.panel.kind === 'figure' ? s.panel.caption : s.panel.small}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="viewer__row">
          <div class="panel metric">
            <p class="panel__bar"><span>METRIC</span></p>
            {stops.map((s, i) => (
              <div data-for={s.id} hidden={i > 0}>
                <p class="metric__value">{s.metric.value}</p>
                <p class="metric__context">{s.metric.context}</p>
              </div>
            ))}
          </div>
          <div class="panel log">
            <p class="panel__bar"><span>LOG</span></p>
            {stops.map((s, i) => (
              <ul role="list" data-for={s.id} hidden={i > 0}>
                {s.log.map((l) => <li class="mono" data-log-line>{l}</li>)}
              </ul>
            ))}
          </div>
        </div>
      </div>
      <ol class="stops" role="list">
        {stops.map((s) => (
          <li id={`t-${s.id}`} class="stop" data-stop={s.id} data-at={s.at} data-track={s.track} data-label={s.period}>
            <p class="stop__meta mono">{s.period}</p>
            <h3 class="stop__title">{s.title}</h3>
            <p class="stop__org">{s.org}</p>
            <p class="sr-only">
              {s.metric.value} {s.metric.context}. {s.log.join('. ')}.
            </p>
            {s.href && (
              <p class="stop__open">
                <a class="play" href={s.href} data-dest={s.title}>
                  <span>Open topic</span>
                  <span class="play__arrow" aria-hidden="true">→</span>
                </a>
              </p>
            )}
          </li>
        ))}
      </ol>

    </div>
  </section>

  <!-- ───────── All topics: the skimmable index ───────── -->
  <section id="all" class="all wrap" aria-labelledby="all-title">
    <h2 id="all-title" class="section-title" data-split="lines">All topics</h2>
    <table class="table">
      <thead>
        <tr><th scope="col">Topic</th><th scope="col">Where</th><th scope="col">When</th><th scope="col">Result</th></tr>
      </thead>
      <tbody>
        {projects.map((p) => (
          <tr>
            <th scope="row"><a class="link" href={`/projects/${p.id}`} data-title>{p.data.title}</a></th>
            <td>{p.data.employer}</td>
            <td class="mono">{range(p.data.period)}</td>
            <td>{p.data.metric ?? ''}</td>
          </tr>
        ))}
        {experience
          .filter((r) => !r.projects)
          .map((r) => (
            <tr>
              <th scope="row">{r.role}</th>
              <td>{r.org}</td>
              <td class="mono">{r.start} to {r.end}</td>
              <td>{r.summary}</td>
            </tr>
          ))}
      </tbody>
    </table>
  </section>

  <!-- ───────── Off the record ───────── -->
  <section id="about" class="about wrap" aria-labelledby="about-title">
    <div class="about__grid">
      <div class="about__text">
        <h2 id="about-title" class="section-title" data-split="lines">Off the record</h2>
        <div class="prose">
          <p>
            Most of my work sits between the camera and the robot: calibration, stereo depth, 3D coordinate
            transforms and real-time detection on edge hardware such as NVIDIA Jetson and Intel RealSense. I
            build production pipelines in Python and C++ and stay with them from the algorithm to the field,
            which is where the hard cases are.
          </p>
          <p>
            B.Sc. in Mechatronics Engineering, Marmara University, 2021. I live in Logatec, ride motorcycles and
            dive, as a 1-star diver.
          </p>
        </div>
      </div>
      <div class="panel about__panel" aria-hidden="true">
        <p class="panel__bar"><span>CAMERA</span><span>off duty</span></p>
        <p class="about__nodata mono">No sensor data.</p>
      </div>
      <dl class="skills">
        {skills.map((s) => (
          <div>
            <dt class="meta">{s.group}</dt>
            <dd>{s.items}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    gap: var(--space-4) var(--gutter);
    padding-top: clamp(0.5rem, 1.5vw, 1.5rem);
  }

  .hero__title {
    font-size: clamp(2.3rem, 0.9rem + 3.6vw, 4.4rem);
    font-stretch: 112%;
    font-weight: 750;
    line-height: 0.95;
    letter-spacing: -0.035em;
    margin-left: -0.04em;
  }

  .hero__sub {
    margin-top: var(--space-3);
    max-width: 44ch;
    color: var(--c-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: var(--space-4);
  }

  .hero__panels {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 6px;
    margin-top: var(--space-4);
  }

  .hero__camera {
    align-self: start;
  }

  .rec {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--c-panel-accent);
    animation: rec 1.6s ease-in-out infinite;
  }

  @keyframes rec {
    50% {
      opacity: 0.25;
    }
  }

  .hero__scene {
    padding: 0.75rem;
  }

  .hero__open {
    padding: 0 0.75rem 0.8rem;
    font-size: var(--t-s);
  }

  /* Phones: text, then the camera, then the metric */
  @media (max-width: 899px) {
    .hero__text {
      display: contents;
    }
    .hero__panels {
      order: 2;
      grid-template-columns: 1fr;
      margin-top: 0;
    }
    .hero__panels .log {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .hero__text {
      grid-column: 1 / span 5;
    }
    .hero__camera {
      grid-column: 6 / -1;
    }
  }

  /* Metric and log panels (hero and viewer) */
  .metric__value {
    padding: 0.6rem 0.75rem 0;
    font-size: clamp(2rem, 1.2rem + 2.4vw, 3.4rem);
    font-stretch: 112%;
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-panel-accent);
  }

  .metric__context {
    padding: 0.4rem 0.75rem 0.75rem;
    font-size: var(--t-s);
    line-height: 1.35;
    color: var(--c-panel-fg);
  }

  .log ul {
    list-style: none;
    padding: 0.5rem 0.75rem 0.75rem;
  }

  .log li {
    font-size: 0.74rem;
    line-height: 1.5;
    color: var(--c-panel-fg);
  }

  .log li::before {
    content: '> ';
    color: var(--c-panel-accent);
  }

  /* ---------- Section heads ---------- */
  .section-title {
    font-size: var(--t-xl);
    font-stretch: 112%;
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  /* ---------- Replay ---------- */
  .replay {
    padding-top: var(--space-7);
  }

  .replay__head {
    display: grid;
    gap: var(--space-2) var(--gutter);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--c-line);
  }

  .replay__hint {
    max-width: 52ch;
    color: var(--c-muted);
  }

  .replay__playing {
    display: none;
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: #b23c0c;
  }

  :global(html.is-playing) .replay__playing {
    display: block;
  }

  .stops {
    list-style: none;
  }

  .stop {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    min-height: 78vh;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--c-line);
  }

  .stop__meta {
    font-size: 0.8rem;
    color: #b23c0c;
  }

  .stop__title {
    font-size: var(--t-l);
    font-stretch: 112%;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    max-width: 18ch;
  }

  .stop__org {
    color: var(--c-muted);
  }

  .stop__open {
    margin-top: var(--space-2);
  }

  .viewer {
    position: sticky;
    top: calc(var(--space-3));
    align-self: start;
    display: grid;
    gap: 6px;
  }

  .viewer__frame {
    position: relative;
    padding: 0.75rem;
  }

  /* Frame drop on a cut: one black frame, then the next topic */
  .viewer.is-drop .viewer__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
  }

  .viewer__fig[hidden],
  [data-for][hidden] {
    display: none;
  }

  .viewer__type {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 6;
    border: 1px dashed var(--c-panel-line);
    font-size: clamp(1.4rem, 1rem + 1.2vw, 2rem);
    font-stretch: 112%;
    font-weight: 750;
    letter-spacing: -0.04em;
    color: var(--c-panel-accent);
  }

  .viewer__caption {
    margin-top: 0.6rem;
    font-size: 0.72rem;
    color: var(--c-panel-muted);
  }

  .viewer__row {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 6px;
  }

  @media (min-width: 900px) {
    .replay__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .replay__head .section-title {
      grid-column: 1 / span 5;
    }
    .replay__hint {
      grid-column: 6 / -1;
    }
    .replay__grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gutter);
    }
    .stops {
      grid-column: 1 / span 5;
      grid-row: 1;
    }
    .viewer {
      grid-column: 6 / -1;
      grid-row: 1;
      margin-top: var(--space-4);
    }
  }

  /* Phones: the viewer is a sticky band at the top while the stops scroll under it */
  @media (max-width: 899px) {
    .viewer {
      top: 0;
      z-index: 2;
      padding-block: 0.4rem;
      background: var(--c-bg);
    }
    .viewer__row .log {
      display: none;
    }
    .viewer__row {
      grid-template-columns: 1fr;
    }
    .viewer__frame {
      padding: 0.5rem;
    }
    /* Figures shrink into the band: keep their labels at the figure's own scale */
    .viewer :global(.diagram text) {
      font-size: 15px;
    }
    .viewer :global(.diagram) {
      max-height: 26vh;
      margin-inline: auto;
      width: auto;
    }
    .viewer__type {
      aspect-ratio: auto;
      height: 26vh;
    }
    .metric__value {
      font-size: 1.6rem;
      padding-top: 0.4rem;
    }
    .stop {
      min-height: 48vh;
      /* Jumping to a stop lands its title below the sticky band */
      scroll-margin-top: 52vh;
    }
  }

  /* ---------- All topics ---------- */
  .all {
    padding-top: var(--space-7);
  }

  .table {
    width: 100%;
    margin-top: var(--space-4);
    border-collapse: collapse;
    font-size: var(--t-s);
  }

  .table th,
  .table td {
    padding: 0.75rem 0.75rem 0.75rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--c-line);
  }

  .table thead th {
    font-weight: 500;
    color: var(--c-muted);
  }

  .table tbody th {
    font-size: var(--t-body);
    font-weight: 600;
    max-width: 28ch;
  }

  .table td.mono {
    white-space: nowrap;
    font-size: 0.78rem;
  }

  @media (max-width: 767px) {
    .table thead {
      display: none;
    }
    .table tr {
      display: grid;
      gap: 0.2rem;
      padding-block: 0.8rem;
      border-bottom: 1px solid var(--c-line);
    }
    .table th,
    .table td {
      padding: 0;
      border: 0;
    }
  }

  /* ---------- Off the record ---------- */
  .about {
    padding-top: var(--space-7);
  }

  .about__grid {
    display: grid;
    gap: var(--space-4) var(--gutter);
  }

  .about .prose {
    margin-top: var(--space-3);
  }

  .about__panel {
    align-self: start;
  }

  .about__nodata {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    font-size: 0.8rem;
    color: var(--c-panel-muted);
  }

  .skills {
    border-top: 1px solid var(--c-line);
  }

  .skills div {
    display: grid;
    gap: 0.15rem var(--gutter);
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--c-line);
  }

  .skills dd {
    margin: 0;
  }

  @media (min-width: 600px) {
    .skills div {
      grid-template-columns: 11rem 1fr;
    }
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .about__text {
      grid-column: 1 / span 6;
    }
    .about__panel {
      grid-column: 8 / -1;
    }
    .skills {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rec {
      animation: none;
    }
  }
</style>
