---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import { chapters } from '../data/chapters';
import { site, mailto } from '../lib/site';
import { experience, education, skills } from '../data/experience';

const work = chapters.filter((c) => c.title);
---

<Base cloud>
  <Stage chapters={chapters} fixed />

  <nav class="index" aria-label="Chapters">
    <ol role="list">
      {chapters.map((c) => (
        <li><a href={`#${c.id}`} data-chapter-link>{c.nav}</a></li>
      ))}
    </ol>
  </nav>

  <!-- Hello: the far view of an orchard row -->
  <section id="hello" class="ch ch--hello" data-chapter aria-labelledby="hello-title">
    <div class="hello wrap">
      <h1 id="hello-title" class="hello__title">Robots see the world as points.</h1>
      <p class="hello__sub">
        I'm {site.name}, a computer vision engineer. I make those points accurate enough for a robot arm to pick
        fruit off a tree, outdoors, in sunlight. Now at Pek Automotive in {site.location}.
      </p>
      <p class="hello__hint note">
        <span class="hint-fine">Move the pointer to look around.</span> Press and hold anywhere to see what the camera
        sees. Scroll to rebuild the next scene.
      </p>
    </div>
  </section>

  {work.map((c) => (
    <section id={c.id} class="ch" data-chapter aria-labelledby={`${c.id}-title`}>
      <div class="card wrap">
        <div class="card__text">
          <p class="note card__when">{c.when}</p>
          <h2 id={`${c.id}-title`} class="card__title">{c.title}</h2>
          <p class="card__body">{c.text}</p>
          {c.href && (
            <p class="card__go">
              <a class="go" href={c.href}>Read the project</a>
            </p>
          )}
        </div>
        {c.big && (
          <p class="card__big">
            <span class="card__num">{c.big}</span>
            <span class="card__numnote">{c.bigNote}</span>
          </p>
        )}
      </div>
    </section>
  ))}

  <!-- The record: his name, rebuilt; the rest of the log as plain text -->
  <section id="record" class="ch ch--record" data-chapter aria-labelledby="record-title">
    <div class="record wrap">
      <h2 id="record-title" class="record__title">The whole log</h2>
      <ol class="log" role="list">
        {experience.map((r) => (
          <li>
            <span class="note log__when">{r.start} to {r.end}</span>
            <span class="log__role">{r.role}, {r.org}</span>
            <span class="note log__where">{r.place}</span>
          </li>
        ))}
        <li>
          <span class="note log__when">Graduated {education.date}</span>
          <span class="log__role">{education.degree}, {education.school}</span>
          <span class="note log__where">{education.place}</span>
        </li>
      </ol>
      <dl class="skills">
        {skills.map((s) => (
          <div>
            <dt class="note">{s.group}</dt>
            <dd>{s.items}</dd>
          </div>
        ))}
      </dl>
      <p class="record__aside note">Away from the robots I ride motorcycles and dive, as a 1-star diver.</p>
    </div>
  </section>

  <!-- Contact: in reach -->
  <section id="contact" class="ch ch--contact" data-chapter aria-labelledby="contact-title">
    <div class="contact wrap">
      <h2 id="contact-title" class="sr-only">Contact</h2>
      <p class="contact__lead">Email is the quickest way to reach me.</p>
      <a class="contact__email" href={mailto}>{site.email}</a>
      <p class="contact__row">
        <a class="go go--solid" href={site.cv} download="Abdullah-Erzin-CV.pdf">Download CV</a>
        {site.links.map((l) => (
          <a class="go" href={l.href} rel="me">{l.label}</a>
        ))}
      </p>
      <p class="note contact__foot">
        {site.name}, {site.location}. Set in Bricolage Grotesque. Every scene on this site is generated in code; no
        employer data or imagery.
      </p>
    </div>
  </section>
</Base>

<style>
  .ch {
    position: relative;
    z-index: 1;
    min-height: 150vh;
    overflow-x: clip;
  }

  /* The copy rides with its scene: it pins in the lower half while the reconstruction holds,
     and leaves as the next one starts to form, the next copy right behind it */
  .card {
    position: sticky;
    top: 48vh;
    padding-bottom: 6vh;
  }

  @media (max-width: 767px) {
    .card {
      top: 40vh;
    }
  }

  /* Text over the cloud stays readable: a soft dark field under the copy, not a box */
  .card__text,
  .hello,
  .record,
  .contact {
    position: relative;
    width: 100%;
  }

  .card__text::before,
  .hello::before {
    content: '';
    position: absolute;
    inset: -12vh -20vw -10vh -10vw;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0));
    pointer-events: none;
  }

  /* ---------- Hello ---------- */
  .ch--hello {
    display: grid;
    align-content: end;
    min-height: 100svh;
    padding-bottom: 9vh;
  }

  .hello__title {
    max-width: 11ch;
    font-size: clamp(3.2rem, 0.8rem + 9.6vw, 11.5rem);
    font-stretch: 75%;
    font-weight: 750;
    line-height: 0.86;
    letter-spacing: -0.035em;
    margin-left: -0.04em;
  }

  .hello__sub {
    max-width: 40ch;
    margin-top: 1.6rem;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.4;
  }

  .hello__hint {
    margin-top: 1.4rem;
    max-width: 52ch;
  }

  @media (hover: none) {
    .hint-fine {
      display: none;
    }
  }

  /* ---------- Chapter cards ---------- */
  .card {
    display: grid;
    gap: 2rem var(--gutter);
    align-items: end;
  }

  .card__when {
    color: var(--fg);
    opacity: 0.75;
  }

  .card__title {
    max-width: 14ch;
    margin-top: 0.6rem;
    font-size: clamp(2.2rem, 1rem + 4.2vw, 5.4rem);
    font-stretch: 75%;
    font-weight: 750;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .card__body {
    max-width: 44ch;
    margin-top: 1.1rem;
  }

  .card__go {
    margin-top: 1.4rem;
  }

  /* The one real number, set as an image over the cloud */
  .card__big {
    display: grid;
    justify-items: end;
    text-align: right;
    mix-blend-mode: difference;
  }

  .card__num {
    font-size: clamp(5rem, 1rem + 15vw, 17rem);
    font-stretch: 75%;
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .card__numnote {
    max-width: 24ch;
    margin-top: 0.8rem;
    font-size: 0.95rem;
    line-height: 1.35;
  }

  @media (min-width: 900px) {
    .card {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  /* ---------- Chapter index (a real sequence: the order of the scenes) ---------- */
  .index {
    position: fixed;
    right: var(--pad);
    top: 5.5rem;
    z-index: 30;
    mix-blend-mode: difference;
    color: #fff;
  }

  .index ol {
    list-style: none;
    display: grid;
    gap: 0.15rem;
    justify-items: end;
  }

  .index a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.2rem;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    opacity: 0.55;
    transition: opacity 0.3s;
  }

  .index a::after {
    content: '';
    width: 0.7rem;
    height: 1px;
    background: currentColor;
    transition: width 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .index a[aria-current] {
    opacity: 1;
  }

  .index a[aria-current]::after {
    width: 2.2rem;
  }

  @media (hover: hover) {
    .index a:hover {
      opacity: 1;
    }
    .index a:hover::after {
      width: 1.6rem;
    }
  }

  @media (max-width: 1023px) {
    .index {
      display: none;
    }
  }

  /* ---------- The record ---------- */
  .ch--record {
    min-height: auto;
    padding-block: 40vh 12vh;
  }

  .record {
    padding-top: 2rem;
    background: linear-gradient(rgb(0 0 0 / 0), rgb(0 0 0 / 0.85) 12rem);
  }

  .record__title {
    font-size: clamp(2.2rem, 1rem + 4.2vw, 5.4rem);
    font-stretch: 75%;
    font-weight: 750;
    letter-spacing: -0.03em;
  }

  .log {
    list-style: none;
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .log li {
    display: grid;
    gap: 0.1rem var(--gutter);
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .log__role {
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .log li {
      grid-template-columns: 12rem minmax(0, 1fr) 14rem;
      align-items: baseline;
    }
    .log__where {
      text-align: right;
    }
  }

  .skills {
    display: grid;
    gap: 1.2rem var(--gutter);
    margin-top: 3rem;
  }

  .skills dd {
    margin: 0.2rem 0 0;
    max-width: 40ch;
  }

  @media (min-width: 900px) {
    .skills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .record__aside {
    margin-top: 2.5rem;
  }

  /* ---------- Contact ---------- */
  .ch--contact {
    display: grid;
    min-height: 100svh;
    align-content: end;
    padding-block: 20vh 8vh;
  }

  .contact__lead {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem);
  }

  .contact__email {
    display: inline-block;
    margin-top: 1rem;
    font-size: clamp(1.15rem, 0.2rem + 4.6vw, 5.2rem);
    font-stretch: 75%;
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(var(--hot) 0 0) left 100% / 0% 0.08em no-repeat;
    padding-bottom: 0.1em;
    transition: background-size 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (hover: hover) {
    .contact__email:hover {
      background-size: 100% 0.08em;
    }
  }

  .contact__email:focus-visible {
    background-size: 100% 0.08em;
  }

  .contact__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.4rem;
  }

  .contact__foot {
    margin-top: 3rem;
    max-width: 60ch;
  }

  /* Without WebGL: the page is plain text on black, fully readable */
  :global(html.no-gl) .ch {
    min-height: auto;
    padding-block: 18vh 6vh;
  }

  @media (prefers-reduced-motion: reduce) {
    .ch {
      min-height: 120vh;
    }
  }
</style>
