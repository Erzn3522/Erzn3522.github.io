---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Page not found" noindex>
  <section class="missing wrap">
    <div class="split">
      <div class="content">
        <h1>There is no page at this address.</h1>
        <p class="lead">
          The link may be from the old version of this site, or it may have a typo. Everything that
          was here now lives on the <a href="/">home page</a> or on one of the project pages.
        </p>
        <h2>Projects</h2>
        <ul>
          {projects.map((p) => <li><a href={`/projects/${p.id}`}>{p.data.title}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .missing {
    padding-block: var(--space-5);
  }

  h1 {
    font-size: clamp(2rem, 1.4rem + 2.6vw, var(--step-5));
    max-width: 16ch;
  }

  .lead {
    margin-top: var(--space-3);
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  h2 {
    margin-top: var(--space-5);
    font-size: var(--step-2);
  }

  ul {
    margin-top: var(--space-2);
    padding-left: 1.1em;
  }

  li + li {
    margin-top: 0.4rem;
  }
</style>
