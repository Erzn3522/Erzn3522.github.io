---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Page not found" noindex>
  <section class="missing wrap">
    <p class="note">0 points returned</p>
    <h1 class="title">Nothing at this address to reconstruct.</h1>
    <p class="lead">
      The link may be from the old version of this site, or it may have a typo. Every scene lives on the
      <a class="inline" href="/">home page</a>; the projects are below.
    </p>
    <ul class="list" role="list">
      {projects.map((p) => <li><a class="inline" href={`/projects/${p.id}`}>{p.data.title}</a></li>)}
    </ul>
  </section>
</Base>

<style>
  .missing {
    padding-block: 9rem 6rem;
  }

  .title {
    max-width: 14ch;
    margin-top: 1rem;
    font-size: clamp(2.6rem, 1rem + 6vw, 7rem);
    font-stretch: 75%;
    font-weight: 750;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .lead {
    max-width: 50ch;
    margin-top: 1.6rem;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
  }

  .list {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    margin-top: 3rem;
  }

  .list a {
    display: inline-block;
    padding-block: 0.2rem;
  }
</style>
