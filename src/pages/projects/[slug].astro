---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Stage from '../../components/Stage.astro';
import ThermalScene from '../../components/ThermalScene.astro';
import { chapters } from '../../data/chapters';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const { title, outcome, employer, period, tags, figure, interactive, metric, description } = project.data;
const when = period.replace(/\s*[–—]\s*/g, ' to ');
const nextWhen = next.data.period.replace(/\s*[–—]\s*/g, ' to ');
// The reconstruction for this project, if the home page has one
const chapter = chapters.find((c) => c.href === `/projects/${project.id}`);
---

<Base title={title} description={description ?? outcome} cloud={!!chapter}>
  <article>
    <header class:list={['head', { 'head--cloud': !!chapter }]}>
      {chapter && (
        <div class="head__stage" data-chapter>
          <Stage chapters={[chapter]} />
        </div>
      )}
      <div class="head__text wrap">
        <a class="back inline" href={chapter ? `/#${chapter.id}` : '/#record'}>Back to the scenes</a>
        <p class="note head__when">{employer}, {when}</p>
        <h1 class="title">{title}</h1>
        <p class="outcome">{outcome}</p>
        {metric && <p class="metric">{metric}</p>}
      </div>
    </header>

    {interactive === 'thermal' && (
      <div class="wrap media">
        <ThermalScene caption={figure?.caption} />
      </div>
    )}

    <div class="body wrap">
      <aside class="facts" aria-label="Project details">
        <dl>
          <div><dt class="note">Where</dt><dd>{employer}</dd></div>
          <div><dt class="note">When</dt><dd>{when}</dd></div>
          <div><dt class="note">Methods and tools</dt><dd>{tags.join(', ')}</dd></div>
          {chapter && figure?.caption && !interactive && <div><dt class="note">The scene above</dt><dd class="note">Synthetic, generated in code. {figure.caption}</dd></div>}
        </dl>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="next wrap" aria-label="Next project">
      <p class="note">Next project</p>
      <a class="next__link" href={`/projects/${next.id}`}>
        <span class="next__title">{next.data.title}</span>
        <span class="note">{next.data.employer}, {nextWhen}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .head {
    position: relative;
    padding-top: 6.5rem;
  }

  .head--cloud {
    min-height: 92svh;
    display: grid;
    align-content: end;
    padding-bottom: 6vh;
  }

  .head__stage {
    position: absolute;
    inset: 0;
  }

  /* fade the scene into the page below */
  .head__stage::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    background: linear-gradient(rgb(0 0 0 / 0), #000);
    pointer-events: none;
  }

  .head__text {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .back {
    display: inline-block;
    padding-block: 0.3rem;
    font-size: 0.9rem;
  }

  .head__when {
    margin-top: 1.4rem;
    color: var(--fg);
    opacity: 0.75;
  }

  .title {
    max-width: 16ch;
    margin-top: 0.6rem;
    margin-left: -0.03em;
    font-size: clamp(2.4rem, 1rem + 5vw, 6.4rem);
    font-stretch: 75%;
    font-weight: 750;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .outcome {
    max-width: 48ch;
    margin-top: 1.4rem;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem);
    line-height: 1.4;
  }

  .metric {
    display: inline-block;
    margin-top: 1.2rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--hot);
    border-radius: 999px;
    color: var(--hot);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .media {
    margin-top: 4rem;
  }

  .body {
    display: grid;
    gap: 3rem var(--gutter);
    margin-top: 5rem;
  }

  .facts dl {
    border-top: 1px solid var(--line);
  }

  .facts div {
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .facts dd {
    margin: 0.15rem 0 0;
  }

  @media (min-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    }
    .facts {
      position: sticky;
      top: 5rem;
      align-self: start;
    }
  }

  .next {
    margin-top: 8rem;
    padding-block: 2rem 6rem;
    border-top: 1px solid var(--line);
  }

  .next__link {
    display: inline-grid;
    gap: 0.8rem;
    margin-top: 1rem;
    text-decoration: none;
  }

  .next__title {
    max-width: 18ch;
    font-size: clamp(2rem, 1rem + 4vw, 5.2rem);
    font-stretch: 75%;
    font-weight: 750;
    line-height: 0.95;
    letter-spacing: -0.03em;
    transition: translate 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.3s;
  }

  @media (hover: hover) {
    .next__link:hover .next__title {
      translate: 0.6rem 0;
      color: var(--hot);
    }
  }

  .next__link:focus-visible .next__title {
    translate: 0.6rem 0;
    color: var(--hot);
  }
</style>
